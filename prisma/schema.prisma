// ============================================================================
// Star Press — Production Database Schema (Phase C & Roadmap)
// ============================================================================

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ----------------------------------------------------------------------------
// Auth & Users
// ----------------------------------------------------------------------------

enum Role {
  CUSTOMER
  ADMIN
}

model User {
  id                    String                 @id @default(cuid())
  name                  String
  email                 String                 @unique
  passwordHash          String?
  phone                 String?
  role                  Role                   @default(CUSTOMER)
  createdAt             DateTime               @default(now())
  updatedAt             DateTime               @updatedAt

  addresses             Address[]
  orders                Order[]
  reviews               Review[]
  customizationRequests CustomizationRequest[]
}

model Address {
  id        String   @id @default(cuid())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId    String
  label     String?  // e.g. "Office", "Factory", "Home"
  line1     String
  line2     String?
  city      String
  state     String
  pincode   String
  phone     String
  isDefault Boolean  @default(false)
  createdAt DateTime @default(now())
}

// ----------------------------------------------------------------------------
// Catalog
// ----------------------------------------------------------------------------

model Category {
  id           String    @id @default(cuid())
  name         String    @unique
  slug         String    @unique
  description  String?
  imageUrl     String?
  displayOrder Int       @default(0)
  products     Product[]
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
}

model Product {
  id           String         @id @default(cuid())
  category     Category       @relation(fields: [categoryId], references: [id])
  categoryId   String
  name         String
  slug         String         @unique
  description  String?
  basePrice    Decimal        @db.Decimal(10, 2)
  isFeatured   Boolean        @default(false)
  isActive     Boolean        @default(true)
  images       ProductImage[]
  pricingRules PricingRule[]
  cartItems    CartItem[]
  orderItems   OrderItem[]
  reviews      Review[]
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt
}

model ProductImage {
  id           String   @id @default(cuid())
  product      Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  productId    String
  url          String
  altText      String?
  displayOrder Int      @default(0)
}

model PricingRule {
  id        String   @id @default(cuid())
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  productId String
  label     String
  price     Decimal  @db.Decimal(10, 2)
  createdAt DateTime @default(now())
}

// ----------------------------------------------------------------------------
// Cart (Client & Optional Persistent)
// ----------------------------------------------------------------------------

model Cart {
  id        String     @id @default(cuid())
  userId    String?    @unique
  items     CartItem[]
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt
}

model CartItem {
  id        String   @id @default(cuid())
  cart      Cart     @relation(fields: [cartId], references: [id], onDelete: Cascade)
  cartId    String
  product   Product  @relation(fields: [productId], references: [id])
  productId String
  quantity  Int
  unitPrice Decimal  @db.Decimal(10, 2)
  specs     Json?
  createdAt DateTime @default(now())
}

// ----------------------------------------------------------------------------
// Orders & Fulfillment
// ----------------------------------------------------------------------------

enum OrderStatus {
  PENDING
  CONFIRMED
  IN_PRODUCTION
  DISPATCHED
  DELIVERED
  CANCELLED
}

model Order {
  id                String               @id @default(cuid())
  orderNumber       String               @unique // Human readable: SP-YYYY-XXXXX
  user              User?                @relation(fields: [userId], references: [id])
  userId            String?              // Nullable for guest checkouts
  guestEmail        String?
  guestPhone        String?
  guestName         String?
  status            OrderStatus          @default(PENDING)
  subtotal          Decimal              @db.Decimal(10, 2)
  gstAmount         Decimal?             @db.Decimal(10, 2) // Nullable until GST rules confirmed
  shippingFee       Decimal              @default(0) @db.Decimal(10, 2)
  discountAmount    Decimal              @default(0) @db.Decimal(10, 2)
  totalAmount       Decimal              @db.Decimal(10, 2)
  shippingAddress   Json                 // Immutable address snapshot
  billingAddress    Json?                // Optional B2B GST snapshot
  paymentMethod     String?              // RAZORPAY, COD, MANUAL_PROOF
  paymentId         String?              // Gateway transaction identifier
  razorpayOrderId   String?
  paymentStatus     String               @default("UNPAID") // UNPAID, PAID, FAILED, REFUNDED
  notes             String?
  trackingNumber    String?              // Courier AWB
  courierPartner    String?              // Shiprocket, BlueDart, DTDC, etc.
  items             OrderItem[]
  transactions      PaymentTransaction[]
  createdAt         DateTime             @default(now())
  updatedAt         DateTime             @updatedAt
}

model OrderItem {
  id          String   @id @default(cuid())
  order       Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  orderId     String
  product     Product? @relation(fields: [productId], references: [id])
  productId   String?
  productName String
  productSlug String
  quantity    Int
  unitPrice   Decimal  @db.Decimal(10, 2)
  lineTotal   Decimal  @db.Decimal(10, 2)
  specs       Json?    // { sizeId, materialId, dimensions, finish }
  customText  String?
  artworkUrl  String?
  previewUrl  String?
  createdAt   DateTime @default(now())
}

model PaymentTransaction {
  id                String   @id @default(cuid())
  order             Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  orderId           String
  gateway           String   @default("RAZORPAY")
  gatewayOrderId    String?
  gatewayPaymentId  String?
  gatewaySignature  String?
  method            String?  // UPI, CARD, NETBANKING, WALLET
  amount            Decimal  @db.Decimal(10, 2)
  currency          String   @default("INR")
  status            String   // AUTHORIZED, CAPTURED, FAILED
  rawPayload        Json?
  createdAt         DateTime @default(now())
}

// ----------------------------------------------------------------------------
// Inquiries, Leads & Support
// ----------------------------------------------------------------------------

model CustomizationRequest {
  id            String   @id @default(cuid())
  inquiryNumber String?  @unique // INQ-YYYY-XXXXX
  user          User?    @relation(fields: [userId], references: [id])
  userId        String?
  name          String
  email         String
  phone         String
  productType   String
  quantity      String?
  finishDetails String?
  details       String?
  fileUrl       String?
  status        String   @default("NEW") // NEW, REVIEWED, QUOTED, CONVERTED, CLOSED
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}

model BulkOrderInquiry {
  id                  String   @id @default(cuid())
  inquiryNumber       String?  @unique // BLK-YYYY-XXXXX
  name                String
  phone               String
  email               String?
  company             String?
  productType         String?
  quantity            String?
  details             String?
  swatchKitRequested  Boolean  @default(false)
  status              String   @default("NEW") // NEW, CONTACTED, QUOTED, WON, LOST
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt
}

model ContactInquiry {
  id            String   @id @default(cuid())
  inquiryNumber String?  @unique // CNT-YYYY-XXXXX
  name          String
  email         String?
  phone         String?
  subject       String?
  message       String
  status        String   @default("NEW") // NEW, REPLIED, ARCHIVED
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}

model Review {
  id        String   @id @default(cuid())
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  productId String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId    String
  rating    Int      // 1 to 5 stars
  comment   String?
  createdAt DateTime @default(now())
}
