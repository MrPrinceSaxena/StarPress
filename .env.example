# Copy this file to .env.local and fill in real values. Never commit .env.local.

# --- Database (required from Phase 0) ---
DATABASE_URL="postgresql://user:password@localhost:5432/starpress?schema=public"

# --- Auth (required from Phase 1) ---
NEXTAUTH_SECRET="generate-a-random-string"
NEXTAUTH_URL="http://localhost:3000"

# --- File storage for product images / customer uploaded designs (Phase 2+) ---
CLOUDINARY_URL="cloudinary://<key>:<secret>@<cloud_name>"

# --- Payments (required from Phase 5) ---
RAZORPAY_KEY_ID=""
RAZORPAY_KEY_SECRET=""
